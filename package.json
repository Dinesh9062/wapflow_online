{
  "name": "wapflow-connect",
  "private": true,
  "version": "1.4.13",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @zfleet/extension && npm run build -w @zfleet/admin && npm run build -w @zfleet/api",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx --test tests/api.integration.ts tests/delivery.integration.ts",
    "dev:demo": "vite --config apps/extension/vite.config.ts --host 127.0.0.1",
    "dev:admin": "npm run dev -w @zfleet/admin",
    "dev:api": "npm run dev -w @zfleet/api",
    "dev:worker": "npm run dev -w @zfleet/worker",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "node --import tsx scripts/seed.ts",
    "package": "node scripts/package.mjs",
    "test:worker": "node --import tsx --test tests/worker.integration.ts",
    "test:all": "npm run build && npm run typecheck && npm test && npm run test:api && npm run test:worker",
    "demo:setup": "node --env-file=.env --import tsx scripts/seed.ts",
    "check:setup": "node --env-file=.env --import tsx scripts/check-setup.ts",
    "postinstall": "node scripts/ensure-prisma.mjs",
    "prebuild": "node scripts/ensure-prisma.mjs",
    "predb:seed": "node scripts/ensure-prisma.mjs",
    "predemo:setup": "node scripts/ensure-prisma.mjs",
    "precheck:setup": "node scripts/ensure-prisma.mjs",
    "admin:grant": "node --env-file=.env --import tsx scripts/grant-admin.ts",
    "preadmin:grant": "node scripts/ensure-prisma.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/chrome": "^0.1.24",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
